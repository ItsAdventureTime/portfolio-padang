FROM docker.io/library/golang:alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go test ./...
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/padang-api ./cmd/api

FROM docker.io/library/alpine:latest
RUN apk add --no-cache ca-certificates wget
COPY --from=builder /out/padang-api /usr/local/bin/padang-api
USER nobody:nobody
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD wget -qO- http://127.0.0.1:8080/api/v1/health || exit 1
ENTRYPOINT ["/usr/local/bin/padang-api"]
