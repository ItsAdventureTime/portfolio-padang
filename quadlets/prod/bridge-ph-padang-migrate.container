[Unit]
Description=Padang ERP Production database migrations
After=bridge-ph-padang-db.service
Requires=bridge-ph-padang-db.service

[Container]
Image=docker.io/migrate/migrate:latest
ContainerName=bridge-ph-padang-migrate
Network=bridge-ph-padang.network
Volume=/home/jk/bridge-ph/padang/migrations:/migrations:ro
Environment=DB_HOST=bridge-ph-padang-db
Environment=DB_NAME=padang_prod
Environment=DB_USER=padang_prod_user
Secret=bridge-ph-padang-prod-db-password,type=mount,target=/run/secrets/db-password
Entrypoint=/bin/sh
Exec=-ec 'export PGPASSWORD="$(cat /run/secrets/db-password)"; exec migrate -path /migrations -database "postgres://padang_prod_user@bridge-ph-padang-db:5432/padang_prod?sslmode=disable" up'

[Service]
Type=oneshot
RemainAfterExit=yes
