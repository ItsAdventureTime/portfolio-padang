[Unit]
Description=Padang ERP Production PostgreSQL
After=network-online.target bridge-ph-padang.network

[Container]
Image=docker.io/library/postgres:alpine
ContainerName=bridge-ph-padang-db
Network=bridge-ph-padang.network
Volume=/home/jk/bridge-ph/padang/postgres-data:/var/lib/postgresql/data:Z
Environment=POSTGRES_DB=padang_prod
Environment=POSTGRES_USER=padang_prod_user
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/db-password
Secret=bridge-ph-padang-prod-db-password,type=mount,target=/run/secrets/db-password
HealthCmd=pg_isready -U padang_prod_user -d padang_prod
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
Notify=healthy
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
